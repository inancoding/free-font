<div class="hero">
  <h1>开源免费字体聚合站</h1>
  <p>收录授权明确允许免费使用的字体，提供预览与下载</p>
  <div class="stats">
    <span>共 <strong><%= fonts.length %></strong> 款字体</span>
    <span>镜像 <strong><%= mirroredCount %></strong> 款</span>
    <span>外链 <strong><%= fonts.length - mirroredCount %></strong> 款</span>
  </div>
</div>

<div class="toolbar">
  <input id="search-input" class="search-box" type="search" placeholder="搜索字体名称、厂商、标签…">
</div>

<div class="toolbar">
  <div class="filter-group" id="category-filters">
    <button class="filter-btn" data-value="">全部分类</button>
    <button class="filter-btn" data-value="sans-serif">无衬线</button>
    <button class="filter-btn" data-value="serif">衬线</button>
    <button class="filter-btn" data-value="monospace">等宽</button>
    <button class="filter-btn" data-value="display">展示</button>
    <button class="filter-btn" data-value="handwriting">手写</button>
  </div>
</div>

<div class="toolbar">
  <div class="filter-group" id="lang-filters">
    <button class="filter-btn" data-value="">全部语言</button>
    <button class="filter-btn" data-value="zh-Hans">简体中文</button>
    <button class="filter-btn" data-value="zh-Hant">繁体中文</button>
    <button class="filter-btn" data-value="en">英语</button>
    <button class="filter-btn" data-value="ja">日语</button>
    <button class="filter-btn" data-value="ko">韩语</button>
    <button class="filter-btn" data-value="vi">越南语</button>
    <button class="filter-btn" data-value="th">泰语</button>
    <button class="filter-btn" data-value="ar">阿拉伯语</button>
    <button class="filter-btn" data-value="ru">俄语</button>
    <button class="filter-btn" data-value="el">希腊语</button>
  </div>
</div>

<div class="toolbar">
  <div class="filter-group" id="tag-filters">
    <button class="filter-btn" data-value="">全部标签</button>
    <button class="filter-btn" data-value="等宽">等宽</button>
    <button class="filter-btn" data-value="标题">标题</button>
    <button class="filter-btn" data-value="正文">正文</button>
    <button class="filter-btn" data-value="代码">代码</button>
    <button class="filter-btn" data-value="古籍">古籍</button>
    <button class="filter-btn" data-value="可变字体">可变字体</button>
    <button class="filter-btn" data-value="多语言">多语言</button>
    <button class="filter-btn" data-value="编程">编程</button>
    <button class="filter-btn" data-value="UI">UI</button>
    <button class="filter-btn" data-value="手写">手写</button>
  </div>
</div>

<div class="font-grid" id="font-grid">
  <% fonts.forEach(function(font) { %>
    <%- include('_font-card', { font: font }) %>
  <% }); %>
</div>

<script src="scripts/search.js"></script>
