<%
  var name = font.name.zh && font.name.en
    ? font.name.zh + ' / ' + font.name.en
    : (font.name.zh || font.name.en || font.slug);
  var catLabels = { 'sans-serif': '无衬线', 'serif': '衬线', 'monospace': '等宽', 'display': '展示', 'handwriting': '手写' };
%>

<div class="detail-header">
  <h1><%= name %></h1>
  <div class="vendor"><%= font.vendor %> · v<%= font.version %></div>
</div>

<div class="detail-grid">
  <div class="detail-preview">
    <% if (font.preview) { %>
      <img src="../images/<%= font.preview %>" alt="<%= name %>">
    <% } else { %>
      <span style="font-size: 4rem; color: var(--text-secondary);"><%= (font.name.zh || font.name.en || '?').charAt(0) %></span>
    <% } %>
  </div>
  <div class="detail-info">
    <% if (font.description) { %>
      <p><%= font.description %></p>
    <% } %>
    <dl>
      <dt>授权</dt>
      <dd>
        <% if (licenseInfo.url) { %>
          <a href="<%= licenseInfo.url %>" target="_blank" rel="noopener"><%= font.license %></a>
        <% } else { %>
          <%= font.license %>
        <% } %>
      </dd>
      <dt>字重</dt>
      <dd><%= font.weights.join('、') %></dd>
      <dt>格式</dt>
      <dd><%= font.formats.join('、') %></dd>
      <dt>语言</dt>
      <dd><%= font.languages.join('、') %></dd>
      <% if (font.category) { %>
        <dt>分类</dt>
        <dd><%= catLabels[font.category] || font.category %></dd>
      <% } %>
      <dt>收录日期</dt>
      <dd><%= font.addedAt %></dd>
    </dl>
  </div>
</div>

<div class="download-section">
  <h2>下载</h2>
  <% if (font.downloadLinks && font.downloadLinks.length > 0) { %>
    <div class="download-links">
      <% font.downloadLinks.forEach(function(link) { %>
        <a class="btn <%= link.primary ? 'btn-primary' : 'btn-secondary' %>" href="<%= link.url %>" target="_blank" rel="noopener"><%= link.label %></a>
      <% }); %>
      <% if (font.releaseUrl) { %>
        <a class="btn btn-secondary" href="<%= font.releaseUrl %>" target="_blank" rel="noopener">Release 页面</a>
      <% } %>
    </div>
  <% } else { %>
    <p class="download-unavailable">该字体尚未发版，暂无下载链接。</p>
  <% } %>
  <div class="download-links" style="margin-top: 0.5rem;">
    <a class="btn btn-secondary" href="<%= font.officialUrl %>" target="_blank" rel="noopener">字体官网</a>
  </div>
</div>

<% if (font.constraints.length > 0) { %>
<div class="constraints-section">
  <h2>分发与使用限制</h2>
  <ul>
    <% font.constraints.forEach(function(c) { %>
      <li><%= c %></li>
    <% }); %>
  </ul>
</div>
<% } %>

<% if (licenseInfo.constraints && licenseInfo.constraints.length > 0) { %>
<div class="constraints-section">
  <h2><%= font.license %> 通用条款</h2>
  <ul>
    <% licenseInfo.constraints.forEach(function(c) { %>
      <li><%= c %></li>
    <% }); %>
  </ul>
</div>
<% } %>

<% if (font.notes) { %>
<div class="notes-section">
  <h2>备注</h2>
  <p><%= font.notes %></p>
</div>
<% } %>
