{
  "name": "free-font",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "开源免费字体聚合站 —— 静态网站 + GitHub Releases 分发",
  "license": "CC0-1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/dev-server.ts",
    "upload": "tsx scripts/upload-release.ts",
    "validate": "tsx scripts/validate.ts",
    "build:readme": "tsx scripts/build-readme.ts",
    "build:site": "tsx scripts/build-site.ts",
    "build": "tsx scripts/build-site.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run validate"
  },
  "dependencies": {
    "ejs": "^6.0.1"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/node": "^26.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "zod": "^4.1.12"
  }
}
